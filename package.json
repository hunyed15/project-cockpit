{
  "name": "@hunyed15/project-cockpit",
  "version": "0.1.0",
  "description": "Project cockpit for DeepSeek Harness: read-only project progress (where we are, what blocks, next step) with one action that drives the agent.",
  "license": "MIT",
  "author": "hunyed15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunyed15/dsh-project-cockpit.git"
  },
  "homepage": "https://github.com/hunyed15/dsh-project-cockpit#readme",
  "bugs": {
    "url": "https://github.com/hunyed15/dsh-project-cockpit/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "project-dashboard",
    "trellis",
    "code-review"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/DETAIL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
